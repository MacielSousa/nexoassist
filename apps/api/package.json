{
  "name": "@nexo/api",
  "version": "1.0.0",
  "private": true,
  "description": "API do Nexo Assist: contas, chamados, central de ajuda e atendimento com o agent",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/shared/infra/http/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/shared/infra/http/server.js",
    "typeorm": "tsx --env-file-if-exists=.env src/shared/infra/typeorm/cli.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run -d src/shared/infra/typeorm/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/shared/infra/typeorm/data-source.ts",
    "migration:run:prod": "node dist/shared/infra/typeorm/cli.js migration:run -d dist/shared/infra/typeorm/data-source.js",
    "seed": "tsx --env-file-if-exists=.env src/shared/infra/typeorm/seed/index.ts",
    "seed:prod": "node dist/shared/infra/typeorm/seed/index.js",
    "seed:history": "tsx --env-file-if-exists=.env src/shared/infra/typeorm/seed/seedHistoryCli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@mastra/core": "^1.82.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
