# ---- API ----
PORT=3333
# Origens liberadas no CORS (separe por vírgula).
CORS_ORIGIN=http://localhost:3000

# ---- Banco (Postgres do docker-compose) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=nexo
DB_PASSWORD=nexo
DB_NAME=nexo
DB_LOGGING=false

# ---- Autenticação ----
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Senha inicial dos usuários criados pelo seed (npm run seed).
SEED_PASSWORD=nexo1234

# ---- Modelo do agent (roteador de modelos do Mastra: "<provedor>/<modelo>") ----
# Exemplos: anthropic/claude-haiku-5-5 · openai/gpt-5.4-mini · google/gemini-2.5-flash (tem plano gratuito)
NEXO_MODEL=anthropic/claude-haiku-5-5
# Preencha só a chave do provedor escolhido.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ---- Simulação do sistema legado de chamados ----
SERVICE_DESK_FAILURE_RATE=0.05
SERVICE_DESK_OUTAGE=on
SERVICE_DESK_OUTAGE_PERIOD=240
SERVICE_DESK_OUTAGE_SECONDS=5
