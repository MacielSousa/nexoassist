# Chave do provedor do modelo (obrigatória para o agent responder).
ANTHROPIC_API_KEY=

# Modelo usado pelo agent (roteador de modelos do Mastra: "<provedor>/<modelo>").
NEXO_MODEL=anthropic/claude-haiku-5-5

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres; obrigatório em produção).
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# Pasta dos bancos SQLite (padrão: ~/.nexo-assist). "npm run reset" apaga e recria os dados de exemplo.
# NEXO_DATA_DIR=

# Serviço de chamados simulado.
SERVICE_DESK_TOKEN=dev-service-token
# URL base do serviço; por padrão, o próprio app (/api/service-desk).
# SERVICE_DESK_URL=http://localhost:3000/api/service-desk
# Simulação do sistema legado: probabilidade de falha por requisição e janelas de queda.
SERVICE_DESK_FAILURE_RATE=0.05
SERVICE_DESK_OUTAGE=on
SERVICE_DESK_OUTAGE_PERIOD=240
SERVICE_DESK_OUTAGE_SECONDS=5
